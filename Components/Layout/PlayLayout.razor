<section class="section section-large">
    <div class="container container-narrow">
        <div class="stage">
            <div class="stack stack-lg">
                <h1>@Title</h1>

                @if (!string.IsNullOrWhiteSpace(Subtitle))
                {
                    <h2>@Subtitle</h2>
                }

                @foreach (var paragraph in SplitParagraphs(Description))
                {
                    <p class="type-emphasis">@paragraph</p>
                }

                @if (OnRun.HasDelegate)
                {
                    <div>
                        <button class="button button-primary" @onclick="OnRun">
                            @RunButtonText
                        </button>
                    </div>
                }
            </div>
        </div>
    </div>
</section>

@if (WhenToUse.Any() || KeysToSuccess.Any())
{
    <section class="section">
        <div class="container">
            <div class="stage">
                <div class="grid grid-2">

                    @if (WhenToUse.Any())
                    {
                        <div class="stage">
                            <div class="light light-cool"></div>
                            <div class="frame edge edge-soft shadow-ground">
                                <div class="material material-tinted group stack stack-sm">
                                    <h2>When to use this play</h2>

                                    <ul>
                                        @foreach (var item in WhenToUse)
                                        {
                                            <li>@item</li>
                                        }
                                    </ul>
                                </div>
                            </div>
                        </div>
                    }

                    @if (KeysToSuccess.Any())
                    {
                        <div class="stage">
                            <div class="light light-warm"></div>
                            <div class="frame edge edge-soft shadow-ground">
                                <div class="material material-tinted group stack stack-sm">
                                    <h2>Keys to success</h2>

                                    <ul>
                                        @foreach (var item in KeysToSuccess)
                                        {
                                            <li>@item</li>
                                        }
                                    </ul>
                                </div>
                            </div>
                        </div>
                    }

                </div>
            </div>
        </div>
    </section>
}

@if (Facts.Any())
{
    <section class="section">
        <div class="container">
            <div class="stage stack stack-lg">
                <h2>What's involved</h2>

                <div class="grid grid-3">
                    @foreach (var fact in Facts)
                    {
                        <div class="stage">
                            <div class="frame edge edge-soft shadow-ground">
                                <div class="material material-clear group stack stack-xs">
                                    <h4>@fact.Label</h4>
                                    <p class="text-focus">@fact.Value</p>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </section>
}

@if (Materials.Any())
{
    <section class="section">
        <div class="container container-narrow">
            <div class="stage stack stack-lg">
                <h2>What you need</h2>

                <ul>
                    @foreach (var item in Materials)
                    {
                        <li>@item</li>
                    }
                </ul>
            </div>
        </div>
    </section>
}

@if (Steps.Any())
{
    <section class="section">
        <div class="container">
            <div class="stage stack stack-lg">
                <h2>Step-by-step breakdown</h2>

                <div class="stack stack-xl">
                    @foreach (var step in Steps)
                    {
                        <div class="grid @GetStepGridClass(step)">

                            <div class="stage stack">
                                <h3>@step.Title</h3>

                                @foreach (var paragraph in SplitParagraphs(step.Instruction))
                                {
                                    <p>@paragraph</p>
                                }

                                @if (!string.IsNullOrWhiteSpace(step.WhyItMatters))
                                {
                                    <p class="text-direction">@step.WhyItMatters</p>
                                }
                            </div>

                            @if (step.Tips.Any() || !string.IsNullOrWhiteSpace(step.Timebox))
                            {
                                <div class="stage">
                                    <div class="light light-cool"></div>
                                    <div class="frame edge edge-focus shadow-ground">
                                        <div class="material material-frosted group stack stack-sm">
                                            @if (!string.IsNullOrWhiteSpace(step.Timebox))
                                            {
                                                <p class="label">@step.Timebox</p>
                                            }

                                            @if (step.Tips.Any())
                                            {
                                                <h4>Facilitator tips</h4>

                                                <ul>
                                                    @foreach (var tip in step.Tips)
                                                    {
                                                        <li>@tip</li>
                                                    }
                                                </ul>
                                            }
                                        </div>
                                    </div>
                                </div>
                            }

                        </div>
                    }
                </div>
            </div>
        </div>
    </section>
}

@if (ChildContent is not null)
{
    @ChildContent
}

@code {
    [Parameter] public string Title { get; set; } = "";
    [Parameter] public string Subtitle { get; set; } = "";
    [Parameter] public string Description { get; set; } = "";
    [Parameter] public string RunButtonText { get; set; } = "Run it!";
    [Parameter] public EventCallback OnRun { get; set; }
    [Parameter] public IReadOnlyList<string> WhenToUse { get; set; } = Array.Empty<string>();
    [Parameter] public IReadOnlyList<string> KeysToSuccess { get; set; } = Array.Empty<string>();
    [Parameter] public IReadOnlyList<PlayFact> Facts { get; set; } = Array.Empty<PlayFact>();
    [Parameter] public IReadOnlyList<string> Materials { get; set; } = Array.Empty<string>();
    [Parameter] public IReadOnlyList<PlayStep> Steps { get; set; } = Array.Empty<PlayStep>();
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private static IEnumerable<string> SplitParagraphs(string? content)
    {
        return string.IsNullOrWhiteSpace(content)
            ? Array.Empty<string>()
            : content.Split(
                new[] { "\r\n\r\n", "\n\n" },
                StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
    }

    private static bool HasStepSupport(PlayStep step)
    {
        return step.Tips.Any() || !string.IsNullOrWhiteSpace(step.Timebox);
    }

    private static string GetStepGridClass(PlayStep step)
    {
        return HasStepSupport(step) ? "grid-2" : "grid-auto";
    }

    public sealed class PlayFact
    {
        public string Label { get; set; } = "";
        public string Value { get; set; } = "";
    }

    public sealed class PlayStep
    {
        public string Title { get; set; } = "";
        public string Instruction { get; set; } = "";
        public string WhyItMatters { get; set; } = "";
        public string Timebox { get; set; } = "";
        public IReadOnlyList<string> Tips { get; set; } = Array.Empty<string>();
    }
}
