@using OperationalIntelligenceHub.Models
@inject SignalPipelineService SignalService

<div class="card stack">

    <h3>Diagnostics Console</h3>

    <h4>Quick Trace</h4>

    <div class="card text-muted small">
        @if (Signals != null)
        {
            var age = Signals.FirstOrDefault(s => s.Name == "BacklogAge");

            if (age != null)
            {
                <div>
                    AGE → Score: @age.NormalisedValue.ToString("0.00") |
                    Continuum: @FormatNullable(age.ContinuumValue) |
                    Direction: @age.Direction |
                    Shape: @age.Shape
                </div>
            }
        }
    </div>

    <div class="stack">

        <h4>Signals</h4>

        @if (Signals == null || !Signals.Any())
        {
            <p>No signals</p>
        }
        else
        {
            @foreach (var group in Signals.GroupBy(GetLens))
            {
                <div class="stack card">
                    <h3>@group.Key</h3>
                    @foreach (var signal in group.OrderBy (s => s.Name))
                    {
                        <div class="stack card">
                            <div class="grid grid-4">
                                <span>@FormatSignalName(signal.Name)</span>
                                <span>@signal.NormalisedValue.ToString("0.00")</span>
                                <span>@signal.RawValue.ToString("0.00")</span>
                                <span>Dir: @(signal.Direction)</span>
                            </div>
                        </div>
                    }
                </div>
            }
        }

        <h4>Derived Signals</h4>

        @if (DerivedSignals == null || !DerivedSignals.Any())
        {
            <p>No derived signals</p>
        }
        else
        {
            @foreach (var group in DerivedSignals.GroupBy(s => s.Source))
            {
                <div class="stack card">
                    <h5>@group.Key</h5>
                    @foreach (var signal in group)
                    {
                            <div class="grid grid-3">
                                <span>@signal.Name</span>
                                <span>@FormatScore(signal.Score)</span>
                                <span class="text-muted">(@signal.Source)</span>
                            </div>
                            @if (signal.ContributingSignals?.Any() == true)
                            {
                                <div class="text-muted small">
                                    Based on:
                                    @string.Join(", ", signal.ContributingSignals)
                                </div>
                            }
                    }
                </div>
            }
        }

        <h4>Insights</h4>
        <div class="card">
        @if (Insights == null || !Insights.Any())
        {
            <p>No insights</p>
        }
        else
        {
            @foreach (var insight in Insights)
            {
                    <div class="grid grid-3">
                        <span>@insight.Name</span>
                        <span>@insight.Intensity</span>
                        <span class="text-muted">(@insight.Source)</span>
                    </div>
                    @if (!string.IsNullOrEmpty(insight.Interpretation))
                    {
                        <div class="text-muted small">
                            @insight.Interpretation
                        </div>
                    }
                    @if (insight.ContributingSignals?.Any() == true)
                    {
                        <div class="text-muted small">
                            Based on:@string.Join(", ", insight.ContributingSignals)
                        </div>
                    }
            }
        }
        </div>

        @if (RuleEvaluations?.Any() == true)
        {
            
                <h4>Rule Evaluations</h4>
            <div class="card">
                <div class="table-header grid grid-4">
                    <strong>Rule</strong>
                    <strong>Condition</strong>
                    <strong>Result</strong>
                    <strong>Match</strong>
                </div>

                @foreach (var eval in RuleEvaluations)
                {
                    <div class="grid grid-4">
                        <span>@eval.RuleName</span>
                        <span>@eval.Condition</span>
                        <span>@eval.Output</span>
                        <span>@(eval.Result ? "✔" : "✖")</span>
                    </div>
                }
            </div>
        }

    </div>

</div>

@code {

    [Parameter] public List<Signal>? Signals { get; set; }
    [Parameter] public List<DerivedSignal>? DerivedSignals { get; set; }
    [Parameter] public List<OperationalInsight>? Insights { get; set; }
    [Parameter] public List<RuleEvaluation>? RuleEvaluations { get; set; }
    
    private string FormatScore(double score)
    {
        if (score >= 0.8) return "HIGH";
        if (score >= 0.5) return "MODERATE";
        return "LOW";
    }
    private string FormatNullable(double? value)
    {
        return value.HasValue ? value.Value.ToString("0.00") : "-";
    }
    private string GetLens(Signal s)
    {
        if (s.Name.StartsWith("Leader")) return "Leader";
        if (s.Name.StartsWith("SM")) return "Scrum Master";
        if (s.Name.StartsWith("PO")) return "Product Owner";
        if (s.Name.StartsWith("Team")) return "Squad";
        if (s.Domain == "Flow") return "Flow";
        if (s.Domain == "Delivery") return "Delivery";
        return "Other";
    }

    private string FormatSignalName(string name)
    {
        return name
            .Replace("Leader", "")
            .Replace("SM", "")
            .Replace("PO", "")
            .Replace("Team", "")
            .Replace("Level", "");
    }

}