@inject TooltipService TooltipService

@if (!string.IsNullOrEmpty(TooltipService.Text))
{
    <div class="nav-tooltip"
         style="top:@(TooltipService.Top)px; left:@(TooltipService.Left)px; max-width: calc(100vw - 32px);">
        @((MarkupString)TooltipService.Text)
    </div>
}

@code {
    protected override void OnInitialized()
    {
        TooltipService.OnChange += StateHasChanged;
    }
}