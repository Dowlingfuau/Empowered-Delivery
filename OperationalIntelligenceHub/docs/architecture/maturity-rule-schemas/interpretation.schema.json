{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Draft Maturity rule interpretation file",
  "type": "object",
  "required": ["schemaVersion", "fileType", "ruleId", "patternId", "ruleVersion", "status", "definitionStatus", "semanticMetadata", "branchInterpretations", "contextRelationshipInterpretations", "qualificationInterpretations", "narrative", "newInsightCandidates", "implementationBoundaries", "unresolvedItems", "sourceMaterial", "developmentNotes"],
  "properties": {
    "schemaVersion": { "const": "1.0-draft" },
    "fileType": { "const": "interpretation" },
    "ruleId": { "type": "string", "pattern": "^[A-Z]{2}[0-9]{2}-R[0-9]{2}$" },
    "patternId": { "type": "string", "pattern": "^[A-Z]{2}[0-9]{2}$" },
    "ruleVersion": { "anyOf": [{ "type": "string", "minLength": 1 }, { "type": "null" }] },
    "status": { "enum": ["Approved", "Proposed", "Disabled"] },
    "definitionStatus": { "enum": ["Undefined", "DefinedPilot", "Defined"] },
    "semanticMetadata": { "type": ["object", "null"] },
    "branchInterpretations": { "type": ["object", "null"] },
    "contextRelationshipInterpretations": { "type": ["object", "null"] },
    "qualificationInterpretations": { "type": ["object", "null"] },
    "narrative": { "type": ["object", "null"] },
    "newInsightCandidates": { "type": ["array", "null"] },
    "implementationBoundaries": { "type": ["array", "null"], "items": { "type": "string" } },
    "unresolvedItems": { "type": ["array", "null"], "items": { "type": "string" } },
    "sourceMaterial": { "type": "object" },
    "developmentNotes": { "type": "array", "items": { "type": "string" } }
  },
  "allOf": [
    {
      "if": { "properties": { "definitionStatus": { "const": "Undefined" } }, "required": ["definitionStatus"] },
      "then": {
        "properties": {
          "status": { "enum": ["Proposed", "Disabled"] },
          "ruleVersion": { "type": "null" },
          "semanticMetadata": { "type": "null" },
          "branchInterpretations": { "type": "null" },
          "contextRelationshipInterpretations": { "type": "null" },
          "qualificationInterpretations": { "type": "null" },
          "narrative": { "type": "null" },
          "newInsightCandidates": { "type": "null" },
          "implementationBoundaries": { "type": "null" },
          "unresolvedItems": { "type": "null" }
        }
      }
    },
    {
      "if": { "properties": { "definitionStatus": { "const": "DefinedPilot" } }, "required": ["definitionStatus"] },
      "then": {
        "properties": {
          "status": { "enum": ["Proposed", "Disabled"] },
          "ruleVersion": { "type": "string", "minLength": 1 },
          "semanticMetadata": { "type": "object" },
          "branchInterpretations": { "type": "object" },
          "contextRelationshipInterpretations": { "type": "object" },
          "qualificationInterpretations": { "type": "object" },
          "narrative": { "type": "object" },
          "newInsightCandidates": { "type": "array" },
          "implementationBoundaries": { "type": "array" },
          "unresolvedItems": { "type": "array" }
        }
      }
    }
  ]
}
