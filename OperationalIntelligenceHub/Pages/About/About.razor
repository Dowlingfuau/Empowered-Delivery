        letter-spacing: -0.04em;
        font-weight: 600;
        color: var(--about-sand);
    }

    .belief-item p {
        margin: 0;
        max-width: 54rem;
        color: rgba(243, 236, 225, 0.78);
        line-height: 1.7;
    }

    .about-origin {
        background: rgba(11, 15, 18, 0.9);
    }

    .origin-layout {
        margin-top: 20px;
        display: grid;
        grid-template-columns: minmax(250px, 0.72fr) minmax(0, 1.28fr);
        gap: 32px;
        align-items: center;
    }

    .about-photo {
        margin: 0;
        background: rgba(243, 236, 225, 0.04);
        border: 1px solid var(--about-line);
        padding: 18px;
    }

    .about-photo img {
        display: block;
        width: 100%;
        height: 100%;
        max-height: 640px;
        object-fit: cover;
        filter: grayscale(100%) contrast(1.1);
    }

    .origin-copy {
        max-width: 42rem;
    }

    .origin-copy h2 {
        margin: 10px 0 16px;
        font-family: Georgia, "Times New Roman", serif;
        font-size: clamp(2.2rem, 3vw, 3.8rem);
        line-height: 1;
        letter-spacing: -0.05em;
        font-weight: 500;
    }

    .origin-copy p {
        margin: 0 0 16px;
        color: var(--about-ink-soft);
        line-height: 1.7;
        font-size: 1.08rem;
    }

