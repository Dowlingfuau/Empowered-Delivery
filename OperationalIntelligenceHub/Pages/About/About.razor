        margin-bottom: 0;
    }

    .about-loop {
        background: linear-gradient(180deg, rgba(18, 31, 36, 0.96), rgba(11, 14, 16, 1));
    }

    .loop-intro {
        margin-top: 16px;
        display: grid;
        grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
        gap: 24px;
        align-items: end;
        padding: 18px 20px;
        background: rgba(36, 77, 93, 0.1);
        border: 1px solid rgba(36, 77, 93, 0.28);
    }

    .loop-label {
        color: rgba(243, 236, 225, 0.72);
    }

    .loop-intro h2 {
        margin: 0;
        font-family: Georgia, "Times New Roman", serif;
