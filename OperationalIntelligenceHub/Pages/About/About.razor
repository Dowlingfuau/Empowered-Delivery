@page "/about"

@code {
    private readonly Principle[] principles =
    [
        new("THE METRIC IS AN OBSERVATION, NOT THE SYSTEM.", "A metric tells you something about what is happening. It does not tell you why it is happening, or how the system is shaping the behaviour around it."),
        new("CONTEXT CHANGES MEANING.", "The same signal can mean something different in a different operating environment. What looks sensible in one place may be a symptom in another."),
        new("DELIVERY IS A SYSTEM.", "People, structure, incentives, decisions and flow interact. The work does not sit in a single dashboard, or in a single responsibility line."),
        new("UNDERSTANDING CREATES BETTER OPTIONS.", "The more clearly you can see the system, the more deliberately you can choose what to change and what to leave alone."),
        new("OPTIMISATION IS AN EXPERIMENT.", "Change something deliberately. See what shifts. Learn. Adapt. That is how useful improvement becomes visible."),
    ];

    private readonly LoopStep[] steps =
    [
        new("SEE", "Something worth understanding."),
        new("UNDERSTAND", "Connect the signals and the context."),
        new("HYPOTHESISE", "Decide what might be happening."),
        new("ACT", "Try something deliberately."),
        new("LEARN", "Inspect what changed."),
    ];

    private readonly NavLink[] links =
    [
        new("Perspectives", "/perspectives"),
        new("Tools", "/hub"),
        new("Plays", "/plays"),
    ];

    private sealed class Principle(string title, string description)
    {
        public string Title { get; } = title;
        public string Description { get; } = description;
    }

    private sealed class LoopStep(string label, string description)
    {
        public string Label { get; } = label;
        public string Description { get; } = description;
    }

    private sealed class NavLink(string label, string href)
    {
        public string Label { get; } = label;
        public string Href { get; } = href;
    }
}

<PageTitle>About / Empowered Delivery</PageTitle>

<div class="about-concept">
    <header class="about-header">
        <p class="about-kicker">ABOUT / BELIEF LAYER</p>
        <div class="about-hero">
            <div class="about-hero-copy">
                <p class="about-tag">THERE'S MORE TO SEE.</p>
                <h1>Delivery is more than the report.</h1>
            </div>
            <p class="about-hero-note">Empowered Delivery exists to make complex delivery easier to understand, easier to connect and easier to improve.</p>
        </div>
    </header>

    <section class="about-purpose">
        <div class="section-label">ACT I / THE PURPOSE</div>
        <div class="purpose-grid">
            <p class="purpose-lede">Transformation and delivery leaders already have a substantial amount of information available to them. The challenge is not a lack of data. It is the difficulty of understanding it as one system.</p>
            <p class="purpose-body">We built Empowered Delivery to make the hidden relationships within delivery easier to see, to give leaders better tools for interpretation and to help them decide where it is worth acting.</p>
        </div>
    </section>

    <section class="about-beliefs">
        <div class="section-label">ACT II / WHAT WE BELIEVE</div>
        <div class="belief-intro">
            <p class="belief-quote">THE SYSTEM IS NEVER JUST THE NUMBER.</p>
            <p>Delivery is shaped by patterns, incentives, relationships and constraints, not just by the line of a report. We help leaders read what is actually happening beneath the signal.</p>
        </div>

        <div class="belief-stack" aria-label="Core beliefs behind Empowered Delivery">
            @for (var index = 0; index < principles.Length; index++)
            {
                var principle = principles[index];
                <article class="belief-item">
                    <span class="belief-index">@((index + 1).ToString("00"))</span>
                    <div>
                        <h3>@principle.Title</h3>
                        <p>@principle.Description</p>
                    </div>
                </article>
            }
        </div>
    </section>

    <section class="about-origin">
        <div class="section-label">ACT III / WHY WE BUILT IT</div>
        <div class="origin-layout">
            <figure class="about-photo">
                <img src="/images/tom-dowling.jpg" alt="Tom Dowling in an editorial portrait" />
            </figure>
            <div class="origin-copy">
                <p class="origin-kicker">ORIGIN</p>
                <h2>Tom built this after years inside complex delivery environments.</h2>
                <p>In those settings, the recurring problem was not a shortage of information. It was the difficulty of connecting signals into a useful, credible picture.</p>
                <p>Empowered Delivery exists to make that understanding easier and more accessible — not to replace leadership judgement, but to support it with sharper insight.</p>
            </div>
        </div>
    </section>

    <section class="about-loop">
        <div class="section-label">ACT IV / WHAT WE'RE BUILDING</div>
        <div class="loop-intro">
            <p class="loop-label">A BETTER WAY TO UNDERSTAND DELIVERY.</p>
            <h2>We are building a connected loop that helps leaders see more clearly and act more deliberately.</h2>
        </div>

        <div class="loop-steps" aria-label="Delivery understanding loop">
            @for (var index = 0; index < steps.Length; index++)
            {
                var step = steps[index];
                <article class="loop-step">
                    <span class="loop-number">@((index + 1).ToString("0"))</span>
                    <div>
                        <strong>@step.Label</strong>
                        <p>@step.Description</p>
                    </div>
                </article>
            }
        </div>

        <div class="loop-positioning">
            <p class="positioning-label">NOT ANOTHER FRAMEWORK.</p>
            <p>Empowered Delivery is not about prescribing one correct way to work. It is about helping people understand the system they are actually in, identify opportunities to improve it and decide what is worth trying.</p>
        </div>
    </section>

    <section class="about-close">
        <div class="section-label">END</div>
        <p class="close-strap">UNDERSTANDING IS THE STARTING POINT.</p>
        <nav class="about-links" aria-label="Explore related sections">
            @foreach (var link in links)
            {
                <a href="@link.Href">@link.Label</a>
            }
        </nav>
    </section>
</div>

<style>
    .about-concept {
        --about-paper: #0d1013;
        --about-paper-soft: #10171b;
        --about-ink: #eef3f2;
        --about-ink-soft: rgba(238, 243, 242, 0.72);
        --about-line: rgba(238, 243, 242, 0.12);
        --about-charcoal: #070b0d;
        --about-sand: #f3ece1;
        --about-sand-soft: rgba(243, 236, 225, 0.82);
        --about-petrol: #234d5d;
        --about-petrol-soft: rgba(36, 77, 93, 0.2);
        --about-red: #c65841;
        --about-shadow: 0 30px 80px rgba(0, 0, 0, 0.38);
        background:
            radial-gradient(circle at top left, rgba(36, 77, 93, 0.15), transparent 28%),
            linear-gradient(180deg, #0b0f12 0%, #101619 100%);
        color: var(--about-ink);
        border: 1px solid var(--about-line);
        box-shadow: var(--about-shadow);
    }

    .about-header,
    .about-purpose,
    .about-beliefs,
    .about-origin,
    .about-loop,
    .about-close {
        padding: clamp(24px, 3vw, 42px);
    }

    .about-header,
    .about-purpose,
    .about-beliefs,
    .about-origin,
    .about-loop,
    .about-close {
        background: transparent;
        border-top: 1px solid var(--about-line);
    }

    .about-header {
        border-top: none;
    }

    .about-kicker,
    .section-label,
    .about-tag,
    .origin-kicker,
    .loop-label,
    .positioning-label,
    .about-links a,
    .belief-index,
    .loop-number,
    .close-strap {
        margin: 0;
        text-transform: uppercase;
        letter-spacing: 0.14em;
        font-size: 0.68rem;
        font-weight: 700;
    }

    .about-hero {
        display: grid;
        grid-template-columns: minmax(0, 1.35fr) minmax(220px, 0.75fr);
        gap: 28px;
        align-items: end;
        margin-top: 18px;
    }

    .about-hero-copy h1 {
        margin: 0;
        font-family: Georgia, "Times New Roman", serif;
        font-size: clamp(3.3rem, 7vw, 7.3rem);
        line-height: 0.84;
        letter-spacing: -0.06em;
        font-weight: 500;
        max-width: 820px;
        color: var(--about-sand);
    }

    .about-tag {
        color: rgba(243, 236, 225, 0.7);
        margin-bottom: 12px;
    }

    .about-hero-note {
        margin: 0;
        max-width: 18rem;
        color: var(--about-sand-soft);
        font-size: 1rem;
        line-height: 1.7;
    }

    .about-purpose {
        position: relative;
    }

    .purpose-grid {
        display: grid;
        grid-template-columns: minmax(0, 1.25fr) minmax(0, 0.75fr);
        gap: 28px;
        align-items: stretch;
        margin-top: 24px;
        background: rgba(243, 236, 225, 0.97);
        color: var(--about-charcoal);
        border: 1px solid rgba(7, 11, 13, 0.1);
        box-shadow: 0 18px 50px rgba(0, 0, 0, 0.18);
        padding: clamp(20px, 2vw, 30px);
    }

    .purpose-lede,
    .purpose-body {
        margin: 0;
        line-height: 1.5;
    }

    .purpose-lede {
        font-family: Georgia, "Times New Roman", serif;
        font-size: clamp(1.9rem, 3vw, 3.4rem);
        line-height: 1.05;
        letter-spacing: -0.04em;
        max-width: 16ch;
    }

    .purpose-body {
        max-width: 29rem;
        font-size: 1.08rem;
        color: rgba(7, 11, 13, 0.76);
        display: flex;
        align-items: flex-end;
        padding-top: 12px;
    }

    .about-beliefs {
        background: linear-gradient(180deg, rgba(11, 15, 18, 0.82), rgba(7, 11, 13, 1));
    }

    .belief-intro {
        display: grid;
        grid-template-columns: minmax(0, 1fr) minmax(0, 0.8fr);
        gap: 24px;
        margin-top: 20px;
        align-items: end;
    }

    .belief-quote {
        margin: 0;
        font-family: Georgia, "Times New Roman", serif;
        font-size: clamp(2.1rem, 4vw, 4rem);
        line-height: 0.92;
        letter-spacing: -0.05em;
        color: var(--about-sand);
    }

    .belief-intro p:last-child {
        margin: 0;
        font-size: 1.08rem;
        line-height: 1.7;
        color: var(--about-ink-soft);
    }

    .belief-stack {
        margin-top: 28px;
        display: grid;
        gap: 18px;
    }

    .belief-item {
        display: grid;
        grid-template-columns: 76px minmax(0, 1fr);
        gap: 18px;
        align-items: start;
        padding-top: 18px;
        border-top: 1px solid rgba(243, 236, 225, 0.12);
    }

    .belief-index {
        color: rgba(243, 236, 225, 0.52);
    }

    .belief-item h3 {
        margin: 0 0 8px;
        font-size: clamp(1.35rem, 2vw, 2.2rem);
