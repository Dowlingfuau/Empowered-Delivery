        grid-template-columns: repeat(5, minmax(0, 1fr));
        gap: 16px;
    }

    .loop-step {
        display: flex;
        flex-direction: column;
        gap: 14px;
        padding: 18px 18px 0 0;
        border-top: 1px solid rgba(243, 236, 225, 0.16);
    }

    .loop-number {
        color: rgba(243, 236, 225, 0.56);
    }

    .loop-step strong {
        display: block;
        margin-bottom: 8px;
        font-size: 1.1rem;
        line-height: 1.2;
        letter-spacing: 0.02em;
        text-transform: uppercase;
    }

    .loop-step p {
        margin: 0;
        color: rgba(243, 236, 225, 0.78);
        line-height: 1.65;
    }

    .loop-positioning {
        margin-top: 28px;
        display: grid;
        grid-template-columns: minmax(0, 0.7fr) minmax(0, 1fr);
        gap: 20px;
        padding-top: 22px;
        border-top: 1px solid rgba(243, 236, 225, 0.16);
    }

    .positioning-label {
        color: rgba(243, 236, 225, 0.72);
    }

    .loop-positioning p:last-child {
        margin: 0;
        line-height: 1.7;
        color: rgba(243, 236, 225, 0.78);
    }

    .about-close {
        background: rgba(10, 13, 16, 0.96);
    }

    .close-strap {
        margin-top: 16px;
        font-size: clamp(2.1rem, 4vw, 5rem);
        letter-spacing: -0.06em;
        line-height: 0.9;
        font-family: Georgia, "Times New Roman", serif;
        text-transform: none;
        color: var(--about-sand);
    }

    .about-links {
        display: flex;
        flex-wrap: wrap;
        gap: 12px;
        margin-top: 22px;
    }

    .about-links a {
        display: inline-flex;
        align-items: center;
        padding: 0.8rem 1rem;
        border: 1px solid var(--about-line);
        background: rgba(243, 236, 225, 0.02);
        color: var(--about-ink);
        text-decoration: none;
        transition: background 0.2s ease, transform 0.2s ease;
    }

    .about-links a:hover {
        background: rgba(36, 77, 93, 0.14);
        transform: translateY(-1px);
    }

    .about-links a:focus-visible {
        outline: 2px solid var(--about-sand);
        outline-offset: 2px;
    }

    @@media (max-width: 900px) {
        .about-hero,
        .purpose-grid,
        .belief-intro,
        .origin-layout,
        .loop-intro,
        .loop-positioning {
            grid-template-columns: 1fr;
        }

        .loop-steps {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }

    @@media (max-width: 560px) {
        .about-hero h1 {
            font-size: clamp(2.6rem, 16vw, 4.4rem);
        }

        .loop-steps {
            grid-template-columns: 1fr;
        }

        .belief-item {
            grid-template-columns: 52px minmax(0, 1fr);
        }
    }
</style>