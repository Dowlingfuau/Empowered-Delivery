@page "/hub/backlog-health"
@layout HubLayout
@using OperationalIntelligenceHub.Shared
@using OperationalIntelligenceHub.Models
@using OperationalIntelligenceHub.Services
@using OperationalIntelligenceHub.Components
@inject AssessmentRepositoryService AssessmentRepository
@inject WorkspaceRepositoryService WorkspaceRepository
@inject BacklogHealthSignalBuilderService SignalBuilder
@inject SignalPipelineService SignalPipeline
@inject InsightPlacementService InsightPlacements

<div class="diagnostic-surface backlog-health">
    <div class="container backlog-health-page">

    <!-- HEADER -->
    <header class="backlog-health-heading">
        <h1>Backlog Health</h1>
        <p>Understand what your backlog is telling you</p>
    </header>

    <!-- INPUT PANEL -->
    <section class="backlog-health-inputs" aria-labelledby="backlog-input-title">
        <h2 id="backlog-input-title" class="backlog-section-label">What is the state of your backlog?</h2>
        <p class="input-guidance visually-hidden">
            Enter your backlog data — signals will update instantly
        </p>

        <ControlSurface>
            <div class="backlog-control-row">
            <div class="backlog-control-squad">
            <SquadInput SelectedSquad="@SelectedSquad" SelectedSquadChanged="OnSquadSelected" Compact="true"/>
            </div>

                <div class="backlog-control-inputs">
                <!-- Single Inputs -->
                <InputChip  Value="@TotalItems"
                            ValueChanged="@(v => { TotalItems = v; _ = Recalculate(); })"
                            Placeholder="Backlog"
                            Formatter="@(v => $"{v} backlog items")" />
                
                <!-- Grouped Inputs -->
                <GroupedInputChip  Label="Added"
                            Value1="@Added1"
                            Value1Changed="@(v => { Added1 = v; _ = Recalculate(); })"
                            Value2="@Added2"
                            Value2Changed="@(v => { Added2 = v; _ = Recalculate(); })"
                            Value3="@Added3"
                            Value3Changed="@(v => { Added3 = v; _ = Recalculate(); })" />

                <GroupedInputChip   Label="Throughput"
                            Value1="@Velocity1"
                            Value1Changed="@(v => { Velocity1 = v; _ = Recalculate(); })"
                            Value2="@Velocity2"
                            Value2Changed="@(v => { Velocity2 = v; _ = Recalculate(); })"
                            Value3="@Velocity3"
                            Value3Changed="@(v => { Velocity3 = v; _ = Recalculate(); })" />
                
                <GroupedInputChip   Label="Age"
                                    Value1="@FreshItems"
                                    Value1Changed="@(v => { FreshItems = v; _ = Recalculate(); })"
                                    Value2="@MidAgeItems"
                                    Value2Changed="@(v => { MidAgeItems = v; _ = Recalculate(); })"
                                    Value3="@OldItems"
                                    Value3Changed="@(v => { OldItems = v; _ = Recalculate(); })" />

                <GroupedInputChip   Label="Priority"
                                    Value1="@HighPriority"
                                    Value1Changed="@(v => { HighPriority = v; _ = Recalculate(); })"
                                    Value2="@MediumPriority"
                                    Value2Changed="@(v => { MediumPriority = v; _ = Recalculate(); })"
                                    Value3="@LowPriority"
                                    Value3Changed="@(v => { LowPriority = v; _ = Recalculate(); })" />
                </div>
            <div class="backlog-control-save">
                <button type="button" class="backlog-save" @onclick="SaveBacklogHealth">
                    Save
                </button>
            </div>
            </div>
            
        </ControlSurface>
    </section>

    <!-- OVERALL SYSTEM STATE -->
    <section class="backlog-panel backlog-overall" aria-label="Overall system state">
        <ContinuumBar 
            Title="Overall System State"
            Value="@Health.Position"
            Label="@Health.State"
            Zones="@(new List<string> { "Unhealthy", "Needs Attention", "Healthy" })" />
        <ContextualInsightGroup Placements="@PlacementsFor(null)"
                                AreaLabel="Overall System State"
                                PriorityPlacement="@PriorityPlacement"
                                ShowReason="true"
                                ActionHref="/plays" />
    </section>

    <!-- SYSTEM SIGNALS -->
    <section class="backlog-signals" aria-labelledby="backlog-signals-title">
        <h2 id="backlog-signals-title" class="backlog-section-heading">System Signals</h2>

        <div class="backlog-signal-grid">
            @foreach (var reading in SignalReadings)
            {
                <BacklogHealthSignal @key="reading.Id"
                                     Reading="@reading"
                                     Selected="@(SelectedSignalId == reading.Id)"
                                     RestoreFocus="@(_focusRestoreId == reading.Id)"
                                     FocusRestored="@(() => _focusRestoreId = null)"
                                     OnOpen="OpenSignal" />
            }
        </div>

        @if (SignalReadings.Any(r => PlacementsFor(r.Id).Count > 0))
        {
        <div class="backlog-annotation-grid">
            @foreach (var reading in SignalReadings)
            {
                <div class="backlog-annotation-cell" @key="reading.Id">
                    <ContextualInsightGroup Placements="@PlacementsFor(reading.Id)"
                                            AreaLabel="@reading.Title"
                                            PriorityPlacement="@PriorityPlacement"
                                            ActionHref="/plays" />
                </div>
            }
        </div>
        }
    </section>
    <PredictabilityPanel Available="@(PredictabilitySignal != null && ThroughputHistory.Any())"
                         Headline="@GetPredictabilityHeadline()"
                         Rhythm="@GetPattern()"
                         Evidence="@PredictabilityLabel"
                         Impact="@GetPredictabilityImpact()"
                         Throughput="@ThroughputHistory"
                         Trace="@SignalTraces.FirstOrDefault(t => t.SignalName == "Predictability")">
        <Insights>
            <ContextualInsightGroup Placements="@PlacementsFor("predictability")"
                                    AreaLabel="Predictability"
                                    PriorityPlacement="@PriorityPlacement"
                                    ActionHref="/plays" />
        </Insights>
    </PredictabilityPanel>

    <SignalDeepDive Readings="@SignalReadings"
                    SelectedId="@SelectedSignalId"
                    SelectedIdChanged="@(id => SelectedSignalId = id)"
                    Closed="CloseDeepDive" />
    <DiagnosticsConsolePortal>
        <DiagnosticsConsole Signals="@Signals" Insights="@Insights" SignalTraces="@SignalTraces" />
    </DiagnosticsConsolePortal>
    </div>
</div>

@code {
    private List<DerivedSignal> BehaviourSignals = new();
    private List<DerivedSignal> SystemSignals = new();
    private List<Signal> Signals = new();
    private List<OperationalIntelligenceHub.Models.SignalTrace> SignalTraces = new();
    private List<OperationalInsight> Insights = new();
    private IReadOnlyList<InsightPlacement> Placements = Array.Empty<InsightPlacement>();
    private const string DiagnosticId = "BacklogHealth";

    // Placement only filters the engine's existing order; a null anchor selects the overall area.
    private IReadOnlyList<InsightPlacement> PlacementsFor(string? anchorId) =>
        HasAnyData
            ? Placements.Where(p => p.AnchorId == anchorId).ToList()
            : Array.Empty<InsightPlacement>();

    // The engine returns insights ordered by Score; the first one is emphasised, never re-ranked here.
    // Emphasis is meaningless for a single insight, so it needs at least one other to stand out from.
    private InsightPlacement? PriorityPlacement =>
        HasAnyData && Placements.Count > 1 ? Placements[0] : null;
    private SystemHealth Health = new();
    private async Task RunPipeline()
    {
        var rawSignals = Signals;

        var (behaviour, system, insights, evaluations, health) =
            await SignalPipeline.ProcessSignals(rawSignals);

        BehaviourSignals = behaviour;
        SystemSignals = system;
        Insights = insights;
        Placements = InsightPlacements.Resolve(DiagnosticId, insights);
        Health = health;

        Console.WriteLine($">>> Backlog Pipeline Complete: {Insights.Count} insights");

    }
    private void RefreshSignals()
    {
        var result = SignalBuilder.BuildSignals(
            WorkspaceRepository.ActiveWorkspaceId ?? Guid.Empty,
            string.IsNullOrEmpty(SelectedSquad) ? Guid.Empty : Guid.Parse(SelectedSquad),
            TotalItems ?? 0,
            (Added1 ?? 0) + (Added2 ?? 0) + (Added3 ?? 0),
            ThroughputHistory.Sum(),
            ThroughputHistory,
            FreshItems ?? 0,
            MidAgeItems ?? 0,
            OldItems ?? 0,
            HighPriority ?? 0,
            MediumPriority ?? 0,
            LowPriority ?? 0,
            0 // TODO: Unprioritised (not yet in UI)
        );

        Signals = result.Item1;
        SignalTraces = result.Item2;
    }

    void DebugSignals()
    {
        Console.WriteLine($">>> Backlog Signals Built: {Signals.Count}");

        foreach (var signal in Signals)
        {
            Console.WriteLine($">>> {signal.Name} = {signal.NormalisedValue:F2}");
        }
    }

    // ================================
    // Signal Deep Dive (presentation only; all values come from the calculations above)
    // ================================

    string? SelectedSignalId;
    string? _focusRestoreId;

    void OpenSignal(string id) => SelectedSignalId = id;

    void CloseDeepDive()
    {
        _focusRestoreId = SelectedSignalId;
        SelectedSignalId = null;
    }

    SignalTrace? TraceFor(string signalName) => SignalTraces.FirstOrDefault(t => t.SignalName == signalName);

    static string FirstLine(string label) => label.Split('\n')[0];

    static string Input(int? value) => value?.ToString() ?? "—";

    IReadOnlyList<BacklogHealthSignalReading> SignalReadings => new List<BacklogHealthSignalReading>
    {
        new()
        {
            Id = "size",
            Title = "Backlog Size",
            Explanation = "Backlog Size reflects how much work exists relative to delivery capacity. Too little work can interrupt flow. Too much work creates drag and delays feedback.",
            Available = BacklogSizeSignal != null && HasAnyData,
            Value = HasAnyData ? BacklogSizeSignal?.ContinuumValue ?? 0.5 : 0.5,
            Label = SizeLabel,
            Direction = HasAnyData ? BacklogSizeSignal?.Direction ?? 0 : 0,
            Zones = new List<string> { "Starvation", "", "Overload" },
            EvidenceTitle = "Backlog and throughput",
            Evidence = new()
            {
                new("Backlog", Input(TotalItems)),
                new("Throughput · Sprint -1", Input(Velocity1)),
                new("Throughput · Sprint -2", Input(Velocity2)),
                new("Throughput · Sprint -3", Input(Velocity3))
            },
            Interpretation = BacklogSizeSignal == null ? string.Empty : BacklogSizeSignal.Direction switch
            {
                < 0 => $"At {FirstLine(SizeLabel)}, the current backlog size reading sits toward the starvation side of the continuum.",
                > 0 => $"At {FirstLine(SizeLabel)}, the current backlog size reading sits toward the overload side of the continuum.",
                _ => $"At {FirstLine(SizeLabel)}, the current backlog size reading sits near the balance point of the continuum."
            },
            Trace = TraceFor("BacklogSize")
        },
        new()
        {
            Id = "age",
            Title = "Backlog Age",
            Explanation = "Backlog Age reflects how mature and maintained backlog items are over time. Very new work may lack sufficient understanding, while older work may lose relevance if not actively maintained.",
            Available = AgeSignal != null && AgeLabel != "No age data",
            Value = AgeSignal?.ContinuumValue ?? AgeSignal?.NormalisedValue ?? 0.5,
            Label = AgeLabel,
            Direction = AgeSignal?.Direction ?? 0,
            Zones = new List<string> { "Under-ripe", "", "Over-ripe" },
            EvidenceTitle = "Age profile",
            Evidence = new()
            {
                new("Fresh", Input(FreshItems)),
                new("Mid-age", Input(MidAgeItems)),
                new("Old", Input(OldItems))
            },
            Interpretation = FirstLine(AgeLabel),
            Trace = TraceFor("BacklogAge")
        },
        new()
        {
            Id = "volatility",
            Title = "Backlog Volatility",
            Explanation = "Backlog Volatility reflects how the size of the backlog changes over time. A growing backlog means work is entering faster than it is being completed. A shrinking backlog means work is being completed faster than it is entering.",
            Available = VolatilitySignal != null && HasAnyData,
            Value = VolatilitySignal?.ContinuumValue ?? VolatilitySignal?.NormalisedValue ?? 0.5,
            Label = VolatilityLabel,
            Direction = VolatilitySignal?.Direction ?? 0,
            Zones = new List<string> { "Shrinking", "", "Growing" },
            EvidenceTitle = "Items added and completed",
            Evidence = new()
            {
                new("Added · <2w", Input(Added1)),
                new("Added · 2–4w", Input(Added2)),
                new("Added · >4w", Input(Added3)),
                new("Throughput · Sprint -1", Input(Velocity1)),
                new("Throughput · Sprint -2", Input(Velocity2)),
                new("Throughput · Sprint -3", Input(Velocity3))
            },
            Interpretation = FirstLine(VolatilityLabel),
            Trace = TraceFor("BacklogVolatility")
        },
        new()
        {
            Id = "priority",
            Title = "Prioritisation Clarity",
            Explanation = "Prioritisation reflects how clearly work is ordered and differentiated within the backlog. When work is not prioritised, it may be unclear what should be worked on next. When everything is prioritised similarly, prioritisation loses meaning and does not guide decisions.",
            Available = PrioritisationSignal != null && PriorityLabel != "-",
            Value = PrioritisationSignal?.ContinuumValue ?? 0.5,
            Label = PriorityLabel,
            Direction = PrioritisationSignal?.Direction ?? 0,
            Zones = new List<string> { "No Priorities", "", "No Distinction" },
            EvidenceTitle = "Priority distribution",
            Evidence = new()
            {
                new("High", Input(HighPriority)),
                new("Medium", Input(MediumPriority)),
                new("Low", Input(LowPriority)),
                new("Total backlog", Input(TotalItems))
            },
            Interpretation = FirstLine(PriorityLabel),
            Trace = TraceFor("BacklogPrioritisation")
        }
    };

    // ================================
    // Inputs
    // ================================

    int? TotalItems;
    int? Added1, Added2, Added3;
    int? Velocity1, Velocity2, Velocity3;
    int? FreshItems, MidAgeItems, OldItems;
    int? HighPriority, MediumPriority, LowPriority;
    List<int> ThroughputHistory
    {
        get
        {
            var list = new List<int>();
            if (Velocity1.HasValue) list.Add(Velocity1.Value);
            if (Velocity2.HasValue) list.Add(Velocity2.Value);
            if (Velocity3.HasValue) list.Add(Velocity3.Value);
            return list;
        }
    }
    bool HasAnyData => TotalItems.HasValue || Added1.HasValue || Added2.HasValue || Added3.HasValue || FreshItems.HasValue || MidAgeItems.HasValue ||
    OldItems.HasValue || HighPriority.HasValue || MediumPriority.HasValue || LowPriority.HasValue || Velocity1.HasValue || Velocity2.HasValue || Velocity3.HasValue;
    Signal? BacklogSizeSignal => Signals.FirstOrDefault(s => s.Name == "BacklogSize");
    Signal? PredictabilitySignal => Signals.FirstOrDefault(s => s.Name == "DeliveryPredictability");
    Signal? VolatilitySignal => Signals.FirstOrDefault(s => s.Name == "BacklogVolatility");
    Signal? AgeSignal => Signals.FirstOrDefault(s => s.Name == "BacklogAge");
    Signal? PrioritisationSignal => Signals.FirstOrDefault(s => s.Name == "BacklogPrioritisation");

    private string SelectedSquad { get; set; } = string.Empty;

    private void OnSquadSelected(string squadId)
    {
        SelectedSquad = squadId;
    }
   
    // ================================
    // Calculations
    // ================================

    // Backlog Size
    int SizeScore => BacklogSizeSignal == null ? 0 : (int)(BacklogSizeSignal.NormalisedValue * 100);
    
    //Backlog Age
    int AgeScore => AgeSignal == null ? 0 : (int)(AgeSignal.NormalisedValue * 100);
    
    // Backlog Volatility
    int VolatilityHealth => VolatilitySignal == null ? 0 : (int)(VolatilitySignal.NormalisedValue * 100);
    
    // Backlog Priority
    int PriorityScore => PrioritisationSignal == null ? 0 : (int)(PrioritisationSignal.NormalisedValue * 100);

    // ================================
    // Labels
    // ================================

    // Backlog Size
    string SizeLabel
    {
        get
        {
            if (BacklogSizeSignal == null)
                return "-";

            double weeks = BacklogSizeSignal.RawValue;
            double avgThroughput = ThroughputHistory.Any() ? ThroughputHistory.Average() : 0;

            //Line 1: SO WHAT
            string workHorizon = $"{weeks:F1} weeks of work";
            // Line 2: WHAT
            string context = avgThroughput > 0
                ? $"{TotalItems ?? 0} items | {avgThroughput:F1}/2 weeks"
                : $"{TotalItems ?? 0} items";

            return $"{workHorizon}\n{context}";
        }
    }

    // Backlog Age
    string AgeLabel 
    {
        get
        {
            if (AgeSignal == null)
                return "-";
            
            if (!FreshItems.HasValue && !MidAgeItems.HasValue && !OldItems.HasValue)
                return "No age data";

            int fresh = FreshItems.GetValueOrDefault(0);
            int mid = MidAgeItems.GetValueOrDefault(0);
            int old = OldItems.GetValueOrDefault(0);

            int total = fresh + mid + old;

            if (total == 0)
                return "No age data";

            double freshPct = (double)fresh / total;
            double midPct = (double)mid / total;
            double oldPct = (double)old / total;

            string interpretation = AgeSignal.Shape switch
            {
                "SkewLeft" => "Work is being created too early",
                "SkewRight" => "Work is aging before delivery",
                "Bimodal" => "Work is split between very new and very old",
                "BimodalLeft" => "Work is clustered early with aging spillover",
                "BimodalRight" => "Work is aging with some new inflow",
                _ => "Work is flowing evenly"
            };
            return $"{interpretation}\n({freshPct:P0} fresh | {midPct:P0} mid | {oldPct:P0} old)";
        }
    }

    //Backlog Volatility
    string VolatilityLabel 
    {
        get
        {
            if (VolatilitySignal == null)
                return "-";

            int totalAdded = (Added1 ?? 0) + (Added2 ?? 0) + (Added3 ?? 0);
            int totalCompleted = ThroughputHistory.Sum();

            int net = totalAdded - totalCompleted;

            if (!TotalItems.HasValue || TotalItems.Value == 0)
                return $"{net:+#;-#;0} items";

            double pct = (double)net / TotalItems.Value;
            // SO WHAT
            string interpretation;
            if (Math.Abs(pct) < 0.05)
            {
                interpretation = "Backlog is stable";
            }
            else if (pct > 0)
            {
                interpretation = pct > 0.3
                    ? "Backlog is growing rapidly"
                    : "Backlog is growing steadily";
            }
            else
            {
                interpretation = pct < -0.3
                    ? "Backlog is shrinking rapidly"
                    : "Backlog is shrinking";
            }
            // WHAT (Raw Data)
            string raw = $"Net {net:+#;-#;0} items ({pct:+0%;-0%;0%} change) over time";

            return $"{interpretation}\n{raw}";
        }
    }

    //Backlog Prioritisation
    string PriorityLabel {
        get
        {
            if (PrioritisationSignal == null || !TotalItems.HasValue || TotalItems.Value == 0)
                return "-";

            int prioritisedTotal = (HighPriority ?? 0) + (MediumPriority ?? 0) + (LowPriority ?? 0);
            int unprioritised = Math.Max(0, TotalItems.Value - prioritisedTotal);

            double coverage = (double)prioritisedTotal / TotalItems.Value;

            double highPct = (double)(HighPriority ?? 0) / TotalItems.Value;
            double mediumPct = (double)(MediumPriority ?? 0) / TotalItems.Value;
            double lowPct = (double)(LowPriority ?? 0) / TotalItems.Value;
            // SO WHAT
            string interpretation;
            if (coverage < 0.7)
             {
            interpretation = "A significant portion of work is not prioritised, making sequencing unclear";
            }
            else if (highPct > 0.6)
            {
                interpretation = "Everything is high priority, which implies nothing is priority";
            }
            else if (mediumPct > 0.6)
            {
                interpretation = "Most work sits in the middle, which weakens decision clarity";
            }
            else if (lowPct > 0.6)
            {
                interpretation = "Work is weighted toward low priority, which may delay value delivery";
            }
            else
            {
                interpretation = "Prioritisation is spread, work can be clearly differentiated";
            }
            // WHAT
            string raw = $"{coverage:P0} prioritised | High {highPct:P0} | Med {mediumPct:P0} | Low {lowPct:P0}";
            return $"{interpretation}\n{raw}";
        }
    }

    // ================================
    // Predictability
    // ================================
    
    // Helpers
    double CV => PredictabilitySignal?.RawValue ?? 0;
    double Predictability => PredictabilitySignal?.NormalisedValue ?? 0;
    double AverageThroughput => ThroughputHistory.Any() ? ThroughputHistory.Average() : 0;
    double StandardDeviation =>
        ThroughputHistory.Count < 2
            ? 0
            : Math.Sqrt(ThroughputHistory.Sum(x => Math.Pow(x - AverageThroughput, 2)) / ThroughputHistory.Count);

    // Calculation
    int PredictabilityScore => PredictabilitySignal == null ? 0 : (int)(PredictabilitySignal.NormalisedValue * 100);

    // Headline
    string GetPredictabilityHeadline()
    {
        if (CV < 0.2)
            return "Delivery output is predictable";

        if (CV < 0.6)
            return "Delivery output shows variation";

        return "Delivery output is unpredictable";
    }

    // Pattern
    string GetPattern() => SignalBuilder.ClassifyDeliveryRhythm(ThroughputHistory);

    // Predictability Impact
    string GetPredictabilityImpact()
    {
        if (CV < 0.2)
            return "Stable delivery increases confidence in backlog projections and planning.";

        if (CV < 0.6)
            return "Variation in delivery may affect backlog forecasts and timing confidence.";

        return "Low predictability reduces confidence in delivery timelines, backlog age expectations, and prioritisation effectiveness.";
    }

    // Label
    string PredictabilityLabel => PredictabilitySignal == null 
    ? "-" 
    : $"{AverageThroughput:F0} avg | ±{StandardDeviation:F1} variation | CV {CV:F2}";

    private string PredictabilityTooltipHtml =>
        "Predictability reflects how stable delivery is over time.\n" +
        "The position shows whether output is increasing or decreasing.\n" +
        "Distance from the centre shows how much delivery varies between periods.".Replace("\n", "<br/>");

    // Continua Direction
    int GetPredictabilityDirection()
    {
        if (PredictabilitySignal == null)
            return 0;

        var cv = PredictabilitySignal.RawValue;

        if (cv < 0.5) return -1;   // controlled
        if (cv > 1.0) return 1;    // chaotic

        return 0;
    }

    // ================================
    // SAVE (Clean Version)
    // ================================

    private async Task SaveBacklogHealth()
    {
        var workspaceID = WorkspaceRepository.ActiveWorkspaceId;
        if (workspaceID == null || string.IsNullOrEmpty(SelectedSquad))
            return;
        var result = new AssessmentResult
        {
            Id = Guid.NewGuid(),
            ToolName = "Backlog Health",
            Date = DateTime.Now,
            WorkspaceId = workspaceID.Value,
            SquadId = Guid.Parse(SelectedSquad),

            BacklogSize = SizeScore,
            BacklogAge = AgeScore,
            BacklogVolatility = VolatilityHealth,
            BacklogPriority = PriorityScore,
            BacklogPredictability = PredictabilityScore,
            BacklogHealthScore = 0,

            Notes = $"Backlog Health snapshot"
        };

        await AssessmentRepository.SaveBacklogHealthAsync(result);
    }
    private async Task WorkspaceChanged()
    {
        // Reset selected squad when workspace changes
        SelectedSquad = string.Empty;
        await InvokeAsync(StateHasChanged);
    }
    private Func<Task>? _workspaceChangedHandler;
    protected override Task OnInitializedAsync()
    {
        _workspaceChangedHandler = WorkspaceChanged;
        WorkspaceRepository.OnWorkspaceChanged += _workspaceChangedHandler;
        RefreshSignals();

        return Task.CompletedTask;
    }
    private async Task Recalculate()
    {
        RefreshSignals();
        DebugSignals();
        await RunPipeline();
    }
    public void Dispose()
    {
        if (_workspaceChangedHandler != null)
            WorkspaceRepository.OnWorkspaceChanged -= _workspaceChangedHandler;
    }
}
