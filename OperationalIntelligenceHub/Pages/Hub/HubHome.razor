@page "/hub"
@layout HubLayout
@using OperationalIntelligenceHub.Components.Tools
@implements IDisposable
@inject AssessmentRepositoryService Assessments
@inject WorkspaceRepositoryService WorkspaceRepository

<PageTitle>Tools | Empowered Delivery</PageTitle>

<div class="tools-home">
    <section class="tools-intro" aria-labelledby="tools-home-title">
        <div class="tools-intro-copy">
            <span class="tools-home-kicker">TOOLS / INTELLIGENCE SYSTEM</span>
            <h1 id="tools-home-title">What are you<br /><em>trying to see?</em></h1>
            <p>There isn't one view of a delivery system. Start with the question in front of you.</p>
        </div>
        <div class="tools-intro-principle">
            <span>START ANYWHERE</span>
            <strong>Every investigation gives you something useful.</strong>
            <p>More investigations create more context. Operational MRI helps bring the picture together.</p>
        </div>
    </section>

    <ToolsSystemMap IsLoading="@IsLoadingObservations"
                    HasWorkingContext="@HasWorkingContext"
                    HasBacklogObservation="@HasBacklogObservation"
                    HasTeamObservation="@HasTeamObservation"
                    HasMaturityObservation="@HasMaturityObservation" />

    <ToolInsightCarousel />
</div>

@code {
    private bool IsLoadingObservations = true;
    private bool HasWorkingContext;
    private bool HasBacklogObservation;
    private bool HasTeamObservation;
    private bool HasMaturityObservation;
    private bool _disposed;

    protected override async Task OnInitializedAsync()
    {
        Assessments.OnAssessmentChanged += RefreshAfterDataChanged;
        WorkspaceRepository.OnWorkspaceChanged += RefreshAfterDataChanged;
        await RefreshObservationsAsync();
    }

    private async Task RefreshAfterDataChanged()
    {
        if (_disposed)
        {
            return;
        }

        await InvokeAsync(async () =>
        {
            await RefreshObservationsAsync();
            StateHasChanged();
        });
    }

    private async Task RefreshObservationsAsync()
    {
        var workspaceId = WorkspaceRepository.ActiveWorkspaceId;
        var backlogResults = await Assessments.GetBacklogHealthAsync(workspaceId);
        var teamResults = await Assessments.GetTeamHealthAsync(workspaceId);
        var maturitySessions = await Assessments.GetMaturitySessionsAsync(workspaceId);

        HasWorkingContext = WorkspaceRepository.ActiveWorkspace is not null;
        HasBacklogObservation = backlogResults.Any(HasBacklogData);
        HasTeamObservation = teamResults.Any(HasTeamData);
        HasMaturityObservation = maturitySessions.Any(HasMaturityData);
        IsLoadingObservations = false;
    }

    private static bool HasBacklogData(AssessmentResult result) =>
        result.BacklogHealthScore.HasValue ||
        result.BacklogSize.HasValue ||
        result.BacklogAge.HasValue ||
        result.BacklogVolatility.HasValue ||
        result.BacklogPriority.HasValue ||
        result.BacklogPredictability.HasValue;

    private static bool HasTeamData(AssessmentResult result) =>
        result.TeamHealthScore.HasValue ||
        result.ClarityScore.HasValue ||
        result.SafetyScore.HasValue ||
        result.FlowScore.HasValue ||
        result.CollaborationScore.HasValue ||
        result.FocusScore.HasValue ||
        result.StakeholderScore.HasValue ||
        result.ImprovementScore.HasValue ||
        result.MoraleScore.HasValue;

    private static bool HasMaturityData(AssessmentSession session) =>
        session.LensAssessments?.Any(lens =>
            lens.Themes?.Any(theme => theme.Level > 0) == true) == true;

    public void Dispose()
    {
        _disposed = true;
        Assessments.OnAssessmentChanged -= RefreshAfterDataChanged;
        WorkspaceRepository.OnWorkspaceChanged -= RefreshAfterDataChanged;
    }
}
