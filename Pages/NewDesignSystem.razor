@page "/new-design-system"

<div class="flow">
  <!-- HERO / MARKETING -->
  <section class="section section-tight">
    <div class="container hero-layout">
        <!-- NARRATIVE -->
        <div class="stack stack-lg">
          <h1 class="display">Understand how your team is really operating</h1>
          <p class="text-secondary">Delivery issues often start with team health.</p>        
        </div>
        <div class="stack stack-lg">
          <div></div>
          <div class="hero-actions">
            <div class="stack stack-sm">
              <a class="button button-primary">Start Diagnostic</a>
              <span class="micro subtle">Takes ~2 minutes</span>
            </div>
          </div>
        </div>
    </div>
        
  </section>

  <!-- DIAGNOSTIC -->
  <section class="section">
    <div class="container">
        <div class="stack stack-xl">

          <!-- CONTEXT -->
          <div class="stack stack-sm">
            <h2>Team Morale Diagnostic</h2>
            <p class="text-muted">Answer based on how you feel today.</p>

            <!-- CONFIGURATION -->                         
                <!-- Input Chips (Control Surface Content) -->
                <ControlSurface>
                  <SquadSelector></SquadSelector>
                  <InputChip Placeholder="Size" />
                  <GroupedInputChip Label="Throughput" />
                  <GroupedInputChip Label="Age" />
                  <GroupedInputChip Label="Priority" />
                </ControlSurface> 
          </div>

          <!-- INPUT (BEHAVIOUR SELECTION) -->            
            <div class="grid grid-2">

                <!-- Behaviour Selector Placeholder -->
                <div class="group">
                    <p>Team energy is consistent sprint to sprint</p>
                    <div class="grid grid-2">
                      <button class="button button-primary">Every sprint</button>
                      <button class="button button-secondary">Often</button>
                      <button class="button button-tertiary">Sometimes</button>
                      <button class="button button-destructive">Never</button>
                    </div>
                </div>

                <!-- Behaviour Selector Placeholder -->
                <div class="group">
                    <p>Work feels manageable and sustainable</p>
                    <div class="grid grid-2">
                      <button class="button button-primary">Every sprint</button>
                      <button class="button button-secondary">Often</button>
                      <button class="button button-tertiary">Sometimes</button>
                      <button class="button button-destructive">Never</button>
                    </div>
                </div>

            </div>

          <!-- FEEDBACK (Early Signals) -->
          <div class="stack stack-sm">
              <p class="label">Emerging Signals</p>
              <p class="text-dim">Early indicators based on your inputs.</p>
          </div>
          <div class="stack stack-lg">
            <div class="grid grid-2">

              <!-- Continuum Placeholder -->
                <ContinuumBar 
                  Title="Team Morale Factors"
                  TooltipText="Testing the tooltip text."
                  Label="Happiness Levels"
                  Zones="@(new List<string> { "Life sucks", "", "Life's TOO good" })"
                  ></ContinuumBar>

              <!-- Gauge Placeholder -->
                <Gauge
                  Title="Team Morale Intensity"
                  TooltipText="Testing the tooltip text."
                  Label="How is the team doing out of 10?"
                  Value="80"
                  ></Gauge>
            </div>
          </div>
        </div>
    </div>
  </section>

  <!-- INSIGHT -->
  <section class="section section-break">
    <div class="container">

        <h2 style="text-align: center;margin-bottom: var(--space-lg);">SYSTEM INSIGHT</h2>
     
      <!-- STAGE (Just a div, no class yet) -->
      <div class="stage">
        <!-- EFFECT LAYER (light lives outside material) -->
        <div class="light light-warm"></div>
        <!-- FRAME -->
        <div class="frame shadow-cast edge edge-focus">
          <!-- MATERIAL LAYER -->
          <div class="material material-tinted">
            <!-- CONTENT -->
            <InsightPanel
                Title="What the system is showing"
                Observation="Your team may be experiencing hidden overload."
                WhyItMatters="When pressure builds gradually, it often goes unnoticed until delivery slows."
                Direction="Consider reducing work in progress and improving flow visibility."
              />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Context -->
  <section class="section">
    <div class="container">
      <div class="stack stack-lg">

        <!-- Section Header -->       
          <h3>What this looks like</h3>
          <div class="grid grid-2">
            <div class="stack stack-sm">
              <p class="text-observation">
                Work is entering faster than it is being completed.
              </p>
              <p>
                This creates pressure and reduces delivery predictability.
              </p>
            </div>
            <div class="stack stack-sm">
              <p class="text-challenge">
                Are you comfortable continuing like this?
              </p>
              <p class="text-direction">
                This will not resolve itself.
              </p>
            </div>
          </div>
         
      </div>
    </div>
  </section>

  <!-- EDUCATIONAL ACTION -->
  <section class="section">
    <div class="container container-narrow">
      <div class="stack">
        <h2>Understanding Team Morale</h2>
        <p> Team morale is a leading indicator of delivery performance.</p>
        <p>When morale declines, predictability and flow efficiency are impacted.</p>
      </div>
    </div>
  </section>

</div>