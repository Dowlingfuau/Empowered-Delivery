    .final-surface .final-section-index { color:#a23f31; }.final-surface-intro { margin:58px 0 20px; position:relative; z-index:1; }.final-surface-intro p { color:#a23f31; font-size:12px; letter-spacing:.12em; text-transform:uppercase; }.final-surface-intro h2 { font-family:Georgia,serif; font-size:clamp(50px,7vw,105px); font-weight:400; letter-spacing:-.07em; line-height:.87; margin:18px 0; }.final-surface-intro strong { color:#a23f31; font-weight:400; }
    .final-dashboard-stage { margin-left:28%; max-width:780px; position:relative; }.final-dashboard-stage img { display:block; filter:saturate(.75); width:100%; }.final-dashboard-label,.final-dashboard-callout { background:var(--ink); color:var(--cream); font-size:10px; letter-spacing:.12em; padding:12px 16px; position:absolute; text-transform:uppercase; }.final-dashboard-label { left:-45px; top:24px; }.final-dashboard-label b { color:#76b49e; margin-left:20px; }.final-dashboard-callout { bottom:-20px; right:-22px; }.final-dashboard-callout strong { color:var(--red); }.final-surface-caption { font-family:Georgia,serif; font-size:21px; line-height:1.2; margin:78px 0 0 auto; max-width:330px; }
    .final-contradiction { background:var(--ink); min-height:780px; padding:120px clamp(24px,10vw,160px); position:relative; }.final-contradiction-axis { background:var(--red); height:100%; left:13%; opacity:.7; position:absolute; top:0; width:1px; }.final-contradiction-line { border-bottom:1px solid #3d403d; display:flex; flex-wrap:wrap; font-family:Georgia,serif; font-size:clamp(31px,4.5vw,70px); gap:18px; letter-spacing:-.05em; line-height:1; margin:74px 0 0 12%; padding-bottom:26px; }.final-contradiction-line b { color:var(--red); font-weight:400; }.final-cutaway { background:#d6d0c0; color:var(--ink); min-height:960px; overflow:hidden; padding:115px clamp(24px,8vw,125px); position:relative; }.final-cutaway .final-section-index { color:#a23f31; }.final-cutaway-heading { position:relative; z-index:1; }.final-cutaway-heading h2 { font-size:clamp(52px,7vw,108px); margin:70px 0 24px; }.final-cutaway-heading p { font-size:17px; line-height:1.4; max-width:280px; }.final-cutaway-art { bottom:0; position:absolute; right:-6%; width:72%; }.final-cutaway-art img { display:block; mix-blend-mode:multiply; width:100%; }.final-cutaway-tag { border:1px solid #a23f31; color:#a23f31; font-size:10px; letter-spacing:.15em; padding:7px 10px; position:absolute; }.tag-engine { left:25%; top:35%; }.tag-demand { right:28%; top:58%; }.tag-capacity { bottom:16%; left:46%; }
    .final-lenses { background:#1b272c; display:grid; grid-template-columns:1fr 1fr; min-height:720px; padding:120px clamp(24px,8vw,125px); position:relative; }.final-lenses-heading { align-self:end; }.final-lenses-heading p { color:#d6d0c0; font-family:Georgia,serif; font-size:24px; max-width:330px; }.final-lenses-heading h2 { font-family:Georgia,serif; font-size:clamp(50px,6vw,90px); font-weight:400; letter-spacing:-.07em; line-height:.88; margin:26px 0; }.final-lenses-heading h2 span { color:#91b4bc; }.final-lenses-heading h2 strong { color:var(--red); font-weight:400; }.final-lens-orbit { align-self:center; border:1px solid #78929a; border-radius:50%; height:370px; justify-self:center; position:relative; width:370px; }.final-lens-orbit:before,.final-lens-orbit:after { border:1px solid #5b7379; border-radius:50%; content:""; inset:48px; position:absolute; }.final-lens-orbit:after { inset:110px; }.final-lens-orbit span,.final-lens-orbit b { font-size:10px; letter-spacing:.15em; position:absolute; text-transform:uppercase; }.lens-system { left:12%; top:20%; }.lens-behaviour { right:10%; top:44%; }.lens-culture { bottom:20%; left:15%; }.final-lens-orbit b { color:var(--red); left:50%; line-height:1.3; text-align:center; top:50%; transform:translate(-50%,-50%); }
    .final-clarity { align-items:center; background:var(--cream); color:var(--ink); display:grid; gap:60px; grid-template-columns:1.2fr .8fr; min-height:700px; padding:120px clamp(24px,10vw,155px); }.final-clarity .final-section-index { color:#a23f31; }.final-clarity h2 { font-size:clamp(44px,6vw,88px); margin:52px 0 26px; }.final-clarity-copy>p:last-child { font-size:17px; line-height:1.5; max-width:470px; }    .final-signal { align-items:center; background:#22282a; border:0; border-radius:50%; color:var(--cream); cursor:pointer; display:flex; flex-direction:column; font:inherit; gap:12px; height:320px; justify-content:center; justify-self:center; outline:none; padding:40px; position:relative; text-align:center; width:320px; }.final-signal:focus-visible { box-shadow:0 0 0 3px var(--red); }.signal-ring { border:1px solid #7398a5; border-radius:50%; inset:22px; position:absolute; }.signal-ring:after { background:var(--red); border-radius:50%; content:""; height:20px; left:50%; position:absolute; top:50%; transform:translate(-50%,-50%); width:20px; }.final-signal span,.final-signal strong { font-size:10px; letter-spacing:.14em; position:relative; }.final-signal span { color:#a9c6c7; }.final-signal strong { color:var(--red); }.final-signal small { color:#d4d1c4; font-size:12px; line-height:1.3; max-width:180px; position:relative; }
