    .final-nav-action,.final-hero-link,.final-close-action { border-bottom:1px solid var(--red); color:var(--cream); font-size:11px; letter-spacing:.1em; padding-bottom:7px; text-transform:uppercase; }
    .final-nav-action span,.final-hero-link span,.final-close-action span { color:var(--red); margin-left:12px; }
