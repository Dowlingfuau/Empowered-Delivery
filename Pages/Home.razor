@page "/"
@layout PlatformLayout
@using Microsoft.AspNetCore.Components.Web

<PageTitle>Empowered Delivery</PageTitle>

<div class="final-homepage">
    <header class="final-nav">
        <a class="final-brand" href="#final-top" aria-label="Empowered Delivery home">
            <span class="final-brand-mark">ED</span>
            <span>EMPOWERED<br />DELIVERY</span>
        </a>
        <nav aria-label="Primary navigation">
            <a href="/hub">Tools</a>
            <a href="#final-intelligence">Intelligence</a>
            <a href="/plays">Plays</a>
            <a href="/perspectives">Perspectives</a>
            <a href="/services">Services</a>
            <a href="/about">About</a>
        </nav>
        <a class="final-nav-action" href="#final-close">Start with the system <span>↗</span></a>
    </header>

    <main id="final-top">
        <section class="final-hero">
            <div class="final-hero-copy">
                <p class="final-stamp">A field guide for seeing how delivery really works</p>
                <h1>Reports show the surface.<br /><em>The system is underneath.</em></h1>
                <p class="final-hero-question">Why do my reports tell me we are delivering, but I still cannot see the value?</p>
                <a class="final-hero-link" href="#final-surface">Pull the system into view <span>↓</span></a>
            </div>
            <div class="final-hero-art">
                <img src="/images/Bake%20Off/Final%20round/Hero%20image.jpg" alt="A retro-futurist machine representing the delivery system" />
                <span class="final-art-note final-art-note-top">THE MACHINE / 01</span>
                <span class="final-art-note final-art-note-bottom">BUILT TO REVEAL WHAT MEASURES MISS</span>
            </div>
        </section>

        <section id="final-surface" class="final-surface">
            <div class="final-section-index">02 / THE SURFACE</div>
            <div class="final-surface-intro">
                <p>The dashboard is not lying.</p>
                <h2>It is simply<br /><strong>incomplete.</strong></h2>
            </div>
            <div class="final-dashboard-stage">
                <img src="/images/Bake%20Off/Final%20round/The%20Dashboard.jpg" alt="Dashboard artwork showing a reassuring reporting surface" />
                <div class="final-dashboard-label"><span>WHAT THE REPORT SAYS</span><b>Healthy</b></div>
                <div class="final-dashboard-callout">3 measures<br /><strong>1 story missing</strong></div>
            </div>
            <p class="final-surface-caption">A report can tell you what is happening. It cannot, by itself, tell you why the system keeps behaving that way.</p>
        </section>

        <section class="final-contradiction">
            <div class="final-contradiction-axis" aria-hidden="true"></div>
            <p class="final-section-index">03 / THE CONTRADICTION</p>
            <div class="final-contradiction-line">
                <span>We are delivering consistently,</span>
                <b>but we are not delivering value.</b>
            </div>
            <div class="final-contradiction-line">
                <span>Decisions are decentralised,</span>
                <b>but decisions are slower than ever.</b>
            </div>
            <div class="final-contradiction-line">
                <span>Everything is green.</span>
                <b>Something still is not right.</b>
            </div>
        </section>

        <section class="final-cutaway">
            <div class="final-section-index">04 / PULL THE SYSTEM APART</div>
            <div class="final-cutaway-heading">
                <h2>You cannot understand<br />the engine by reading<br /><em>one dial.</em></h2>
                <p>The useful signal lives in the relationships between measures, behaviour and culture.</p>
            </div>
            <div class="final-cutaway-art">
                <img src="/images/Bake%20Off/Final%20round/The%20Cutaway.jpg" alt="Cutaway view revealing the connected parts of a machine" />
                <span class="final-cutaway-tag tag-engine">ENGINE</span>
                <span class="final-cutaway-tag tag-demand">DEMAND</span>
                <span class="final-cutaway-tag tag-capacity">CAPACITY</span>
            </div>
        </section>

        <section id="final-intelligence" class="final-lenses">
            <div class="final-section-index">05 / THE FULLER PICTURE</div>
            <div class="final-lenses-heading">
                <p>We connect the things reporting normally keeps apart.</p>
                <h2>System measures<br /><span>+ behaviour</span><br /><strong>+ culture</strong></h2>
            </div>
            <div class="final-lens-orbit" aria-label="The three connected lenses of operational intelligence">
                <span class="lens-system">SYSTEM</span>
                <span class="lens-behaviour">BEHAVIOUR</span>
                <span class="lens-culture">CULTURE</span>
                <b>FULLER<br />PICTURE</b>
            </div>
        </section>

        <section class="final-clarity">
            <div class="final-clarity-copy">
                <p class="final-section-index">06 / NEW CLARITY</p>
                <h2>That is not a metric problem.<br /><em>It is a system problem.</em></h2>
                <p>Empowered Delivery helps you investigate the relationships underneath the report, without pretending to know the answer before you look.</p>
            </div>
            <button class="final-signal" type="button" @onclick="() => showSignal = !showSignal" aria-label="Reveal a representative relationship">
                <div class="signal-ring"></div>
                <span>OBSERVATION</span>
                <span>RELATIONSHIP</span>
                <strong>@(showSignal ? "HYPOTHESIS" : "REVEAL THE SIGNAL")</strong>
                @if (showSignal)
                {
                    <small>Completion improves while unplanned demand enters through the side door.</small>
                }
            </button>
        </section>

        <section id="final-tools" class="final-tools">
            <div class="final-section-index">07 / THE TOOLS</div>
            <div class="final-tools-head">
                <h2>Machines for<br /><em>investigation.</em></h2>
                <p>Diagnostics turn a vague feeling into something you can inspect, discuss and act on.</p>
            </div>
            <div class="final-tool-console">
                <div class="final-tool-list" role="tablist" aria-label="Diagnostic tools">
                    <button class="@(selectedTool == "backlog" ? "active" : "")" type="button" @onclick='() => selectedTool = "backlog"'><span>01</span>Backlog Health Monitor</button>
                    <button class="@(selectedTool == "team" ? "active" : "")" type="button" @onclick='() => selectedTool = "team"'><span>02</span>Team Health Check</button>
                    <button class="@(selectedTool == "maturity" ? "active" : "")" type="button" @onclick='() => selectedTool = "maturity"'><span>03</span>Maturity Assessment</button>
                </div>
                <div class="final-tool-readout">
                    <div class="readout-top"><span>DIAGNOSTIC / @selectedTool.ToUpperInvariant()</span><b>READY TO INSPECT</b></div>
                    <div class="readout-grid"><span>Signal strength</span><strong>78</strong><span>Relationships found</span><strong>04</strong><span>Next useful question</span><em>What is entering the system?</em></div>
                    <div class="readout-bar"><i></i></div>
                </div>
            </div>
        </section>

        <section class="final-hypothesis">
            <div class="final-section-index">08 / HYPOTHESIS</div>
            <div class="final-equation">
                <span>WHAT WE SEE</span><b>+</b><span>WHAT CONNECTS</span><b>=</b><strong>A HYPOTHESIS<br />WORTH TESTING</strong>
            </div>
            <button class="final-hypothesis-toggle" type="button" @onclick="() => showHypothesis = !showHypothesis">
                @(showHypothesis ? "Hide the working theory" : "Show the working theory") <span>↗</span>
            </button>
            @if (showHypothesis)
            {
                <p class="final-working-theory">The system may be protecting completion by trading away decision speed. Make that trade-off visible before the team absorbs it.</p>
            }
        </section>

        <section id="final-play" class="final-play">
            <div class="final-play-art"><img src="/images/Bake%20Off/Final%20round/The%20Intervention.jpg" alt="A deliberate mechanical intervention" /></div>
            <div class="final-play-copy">
                <p class="final-section-index">09 / THE PLAY</p>
                <h2>Do not just understand the problem.<br /><em>Try something.</em></h2>
                <p>A Play is a practical intervention that follows from the hypothesis. Small enough to run. Specific enough to learn from.</p>
                <button type="button" class="final-action-button">RUN THE PLAY <span>→</span></button>
            </div>
        </section>

        <section class="final-learning">
            <div class="final-learning-copy">
                <p class="final-section-index">10 / INSPECT / ADAPT / LEARN</p>
                <h2>Try. Observe.<br /><em>Learn what moved.</em></h2>
                <p>There is no magic recommendation. Understanding gets sharper through repeated inspection.</p>
            </div>
            <div class="final-learning-art"><img src="/images/Bake%20Off/Final%20round/The%20Learning%20Loop.jpg" alt="A technical learning loop showing change over time" /></div>
        </section>

        <section class="final-momentum">
            <img src="/images/Bake%20Off/Final%20round/The%20Machine%20in%20Motion.jpg" alt="The machine moving forward with purpose" />
            <div><p class="final-section-index">11 / MOMENTUM</p><h2>Understanding<br /><em>creates momentum.</em></h2></div>
        </section>

        <section id="final-ecosystem" class="final-ecosystem">
            <p class="final-section-index">12 / THE ECOSYSTEM</p>
            <h2>One system.<br /><em>Four ways in.</em></h2>
            <div class="final-ecosystem-route">
                <a href="#final-tools"><b>TOOLS</b><span>understand</span><i>↘</i></a>
                <a href="#final-intelligence"><b>PERSPECTIVES</b><span>think</span><i>↘</i></a>
                <a href="#final-play"><b>PLAYS</b><span>act</span><i>↘</i></a>
                <a href="#final-services"><b>SERVICES</b><span>go deeper</span><i>↘</i></a>
            </div>
        </section>

        <section id="final-services" class="final-services">
            <div class="final-services-art"><img src="/images/Bake%20Off/Final%20round/The%20Driver.jpg" alt="A driver operating the machine" /></div>
            <div class="final-services-copy">
                <p class="final-section-index">13 / HUMAN HELP</p>
                <h2>The machine helps you see.<br /><em>People still decide what to do.</em></h2>
                <p>Use the tools. Build understanding. Try something. Learn. When the problem needs deeper intervention, work with us.</p>
                <a class="final-action-button" href="#final-close">WORK WITH US <span>↗</span></a>
            </div>
        </section>

        <section id="final-close" class="final-close">
            <img src="/images/Bake%20Off/Final%20round/The%20Heroic%20System.jpg" alt="A heroic system ready to move" />
            <div class="final-close-copy"><p class="final-section-index">14 / START HERE</p><h2>Find the thing<br />your reports<br /><em>cannot show you.</em></h2><a class="final-close-action" href="#final-tools">START WITH THE SYSTEM <span>↗</span></a></div>
        </section>
    </main>
</div>

@code {
    private string selectedTool = "backlog";
    private bool showSignal;
    private bool showHypothesis;
}

<style>
    .bakeoff-final-frame { background: #101112; }
    .final-homepage {
        --ink:#111315; --charcoal:#17191a; --cream:#f2eadb; --muted:#a9aaa2; --line:#4a4d4a; --red:#d5523d; --blue:#2f789d;
        background:var(--ink); color:var(--cream); font-family:Inter,Segoe UI,sans-serif; overflow:hidden; position:relative; isolation:isolate;
    }
    .final-homepage a { color:inherit; text-decoration:none; }
    .final-homepage a:hover { opacity:0.9; }
    .final-homepage section { position:relative; }
    .final-nav {
        align-items:center; background:rgba(17,19,21,0.34); backdrop-filter:blur(10px); border-bottom:1px solid rgba(255,255,255,0.06);
        box-sizing:border-box; display:flex; gap:32px; justify-content:space-between; padding:18px clamp(22px,5vw,76px); position:absolute; width:100%; z-index:3;
    }
    .final-brand { align-items:center; display:flex; font-size:10px; font-weight:700; letter-spacing:.1em; line-height:1.15; }
    .final-brand-mark { align-items:center; border:1px solid var(--red); border-radius:2px; color:var(--red); display:flex; font-family:Georgia,serif; font-size:14px; height:34px; justify-content:center; margin-right:10px; width:34px; }
    .final-nav nav { display:flex; font-size:11px; gap:24px; letter-spacing:.1em; text-transform:uppercase; }
