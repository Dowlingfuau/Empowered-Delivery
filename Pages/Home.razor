    .final-hero h1,.final-clarity h2,.final-cutaway h2,.final-tools h2,.final-play h2,.final-learning h2,.final-ecosystem h2,.final-services h2,.final-close h2 { font-family:Georgia,serif; font-weight:400; letter-spacing:-.06em; line-height:.91; }
    .final-hero h1 { font-size:clamp(50px,8vw,120px); margin:38px 0 30px; }
    .final-hero h1 em,.final-clarity h2 em,.final-cutaway h2 em,.final-tools h2 em,.final-play h2 em,.final-learning h2 em,.final-ecosystem h2 em,.final-services h2 em,.final-close h2 em { color:var(--red); font-style:normal; }
    .final-hero-question { color:#d2d0c4; font-size:clamp(16px,2vw,22px); line-height:1.35; max-width:390px; }
    .final-hero-link { display:inline-block; margin-top:52px; }
