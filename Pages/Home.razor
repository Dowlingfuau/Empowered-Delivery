    .final-hero-art:after { background:linear-gradient(90deg,#242426 0%,transparent 32%),linear-gradient(0deg,#242426 0%,transparent 22%); content:""; inset:0; position:absolute; }
    .final-hero-art img { height:100%; object-fit:cover; width:100%; }
    .final-art-note { color:#d1cab9; font-size:9px; letter-spacing:.16em; position:absolute; z-index:1; }
    .final-art-note-top { left:12%; top:11%; }.final-art-note-bottom { bottom:9%; right:14%; }
