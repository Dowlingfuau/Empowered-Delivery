@page "/plays"
@using OperationalIntelligenceHub.Services
<div class="container">

<!-- HERO -->
<Hero>

<h1>Improvement Plays</h1>

<p class="accent-text">
Practical experiments and facilitation techniques for improving delivery systems.
</p>

<p>
These plays help teams explore new ways of working, address systemic constraints,
and test improvement ideas.
</p>

</Hero>

<!-- POPULAR STARTING PLAYS -->
<section class="section">

<h2>
Popular Starting Plays
</h2>

<FeatureGrid Columns="3">
                    <!--- Dynamic Plays Library --->
                    @foreach (var play in PlayLibraryService.Plays)
                    {
                        <div class="card">

                            <div class="card-body">

                                <h3>@play.Title</h3>

                                <p>@play.Description</p>

                                <p class="accent-text">
                                    Difficulty: @play.Difficulty · Duration: @play.Duration
                                </p>

                            </div>

                            <div class="card-footer">

                                <a class="button button-secondary" href="@play.Route">
                                    View Play
                                </a>

                            </div>

                        </div>
                    }
