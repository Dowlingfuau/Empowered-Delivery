@page "/hub"
@layout HubLayout

<div class="container">

    <Hero>

    <h1>Operational Intelligence Hub</h1>

    <p class="accent-text">
    Understand how your teams really deliver work.
    </p>

    <p>
    Run lightweight diagnostics that reveal the hidden dynamics
    of your delivery system.
    </p>

    <a class="button button-primary" href="/hub/backlog-health">
    Run Backlog Health
    </a>

    </Hero>


    <section class="section">

    <h2>
    Start with a quick diagnostic
    </h2>

    <ToolCard
    Title="Backlog Health Monitor"
    Description="Backlogs often reveal the earliest delivery system problems."
    Link="/hub/backlog-health"
    Icon="📋"
    />

    </section>


    <section class="section">

    <h2>
    Core Diagnostics
    </h2>

    <FeatureGrid Columns="3">

    <ToolCard
    Title="Backlog Health Monitor"
    Description="Assess backlog readiness and prioritisation."
    Link="/hub/backlog-health"
    Icon="📋"
    />

    <ToolCard
    Title="Team Health Check"
    Description="Measure collaboration and delivery effectiveness."
    Link="/hub/team-health-check"
    Icon="💬"
    />

    <ToolCard
    Title="Coach Hub"
    Description="Visualise trends and insights across teams."
    Link="/hub/coach-hub"
    Icon="📊"
    />

    </FeatureGrid>

    </section>


    <section class="section">

    <h2>
    From diagnostics to insight
    </h2>

    <FeatureGrid Columns="3">

    <div class="card">
    <h3>Run diagnostics</h3>
    <p>Capture real delivery signals.</p>
    </div>

    <div class="card">
    <h3>Reveal patterns</h3>
    <p>Identify structural delivery problems.</p>
    </div>

    <div class="card">
    <h3>Guide improvement</h3>
    <p>Use insights to focus coaching and improvement.</p>
    </div>

    </FeatureGrid>

    </section>


    <CTASection>

    <h2>Start uncovering real delivery insights</h2>

    <a class="button button-primary" href="/hub/backlog-health">
    Run Backlog Health
    </a>

    </CTASection>

</div>