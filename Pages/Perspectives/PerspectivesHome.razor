@page "/perspectives"

<div class="flow">

    <!-- HERO -->
    <section class="section">
        <div class="container">
            <Hero>
                <h1>Perspectives</h1>

                <p class="accent-text">
                    Observations on delivery systems, transformation, leadership, and organisational design.
                </p>

                <p>
                    This journal explores the patterns behind how work actually flows through organisations.
                </p>
            </Hero>
        </div>
    </section>

    <!-- FEATURED ARTICLE -->
    <section class="section">
        <div class="container">
            <div class="stack stack-lg">
                <!-- STAGE -->
                <div class="grid grid-2">
                    <!-- LEFT -->
                    <div class="stack stack-lg">
                        <h2>Why Large Backlogs Slow Delivery</h2>
                        <p>
                            A growing backlog often signals deeper systemic issues.
                            This article explores how work queues distort prioritisation
                            and reduce delivery focus.
                        </p>

                        <p class="accent-text">
                            Tom Dowling · 29 May, 2026
                        </p>

                        <!-- ACTION -->
                        <div>
                            <a class="button button-primary">
                                Read Article
                            </a>
                        </div>
                    </div>
                    <!-- RIGHT -->
                    <div class="stage">
                        <div class="light light-warm"></div>
                        <div class="frame shadow-cast edge edge-focus">
                            <div class="material material-tinted">
                                <img src="https://www.raycast.com/_next/image?url=%2F_next%2Fstatic%2Fmedia%2Fcover.e4e5c3a7.png&w=640&q=70" />
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- LATEST ARTICLES -->
    <section class="section">
        <div class="container">
            <div class="stack stack-lg">
                <h2>Latest Perspectives</h2>

                <div class="stage">
                    <FeatureGrid Columns="3">
                        <Tile Clickable="true" Variant="tile-flat">
                            <TileHeader>
                                <h3>The Hidden Cost of Work in Progress</h3>
                            </TileHeader>
                            <TileBody>
                                <p>
                                    Work in progress often hides structural delivery problems
                                    that accumulate quietly inside organisations.
                                </p>
                            </TileBody>
                            <TileFooter>
                                <p class="accent-text">
                                    Tom Dowling · 1 June, 2026
                                </p>
                            </TileFooter>
                        </Tile>

                        <Tile Clickable="true">
                            <TileHeader>
                                <h3>When Agile Metrics Mislead Leaders</h3>
                            </TileHeader>
                            <TileBody>
                                <p>
                                    Many delivery metrics measure activity rather than
                                    system behaviour.
                                </p>
                            </TileBody>
                            <TileFooter>
                                <p class="accent-text">
                                    Tom Dowling · 16 May, 2026
                                </p>
                            </TileFooter>
                        </Tile>

                        <Tile Clickable="true" Variant="tile-elevated">
                            <TileHeader>
                                <h3>Why Planning Becomes Reactive</h3>
                            </TileHeader>
                            <TileBody>
                                <p>
                                    Reactive planning is often a signal that too much
                                    work is already in progress.
                                </p>
                            </TileBody>
                            <TileFooter>
                                <p class="accent-text">
                                    Tom Dowling · 10 April, 2026
                                </p>
                            </TileFooter>
                        </Tile>
                    
                    </FeatureGrid>
                </div>
            </div>
        </div>
    </section>

